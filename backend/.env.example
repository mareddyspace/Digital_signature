# Copy the lines you need into your shell or a process manager. The backend reads environment variables.

# Database (default: backend/signguard.db). For PostgreSQL: docker compose up -d db, pip install "psycopg[binary]", then:
# DATABASE_URL=postgresql+psycopg://signguard:signguard@localhost:5432/signguard

# dev   = the admin app's user switcher decides who you are (local only, never in production)
# entra = every call needs an Entra ID token for the SignGuard API
AUTH_MODE=dev

# sample = sample_data/employees.json;  graph = your Microsoft 365 tenant
DIRECTORY_SOURCE=sample

# Needed for DIRECTORY_SOURCE=graph and AUTH_MODE=entra
ENTRA_TENANT_ID=
ENTRA_API_CLIENT_ID=
ENTRA_API_CLIENT_SECRET=
ENTRA_API_AUDIENCE=api://<ENTRA_API_CLIENT_ID>
# Made admin on the first Graph sync, so someone can sign in to the admin app
BOOTSTRAP_ADMINS=you@yourtenant.onmicrosoft.com

# Your company's email domains (comma-separated); everyone else is "external"
INTERNAL_DOMAINS=contoso.com
COMPANY_NAME=Contoso
VERIFY_URL=http://localhost:8000/verify

# Used to hash recipients for verification codes. Set a long random value in production.
CODE_SECRET=dev-only-secret-change-me
CORS_ORIGINS=http://localhost:5173,https://localhost:3000
